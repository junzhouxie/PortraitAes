# Required by SFT/GRPO launchers
MODEL_PATH=/path/to/Qwen3.5-VL-9B
DATASET_PATH=/path/to/train.jsonl

# Required by GRPO
SFT_ADAPTER=/path/to/sft/checkpoint

# Distributed training (single-node defaults are 1/1/0/127.0.0.1)
NNODES=1
NPROC_PER_NODE=8
NODE_RANK=0
MASTER_ADDR=127.0.0.1
MASTER_PORT=29500
CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
